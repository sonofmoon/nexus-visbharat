{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexus.visbharat.ward_polygons.schema.json",
  "title": "Ward Polygons",
  "description": "Per-district ward boundary polygons for point-in-polygon ward resolution.",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": {
    "type": "array",
    "minItems": 1,
    "items": {
      "type": "object",
      "required": ["ward", "points"],
      "properties": {
        "ward": { "type": "string", "minLength": 1 },
        "points": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["lat", "lng"],
            "properties": {
              "lat": { "type": "number", "minimum": -90, "maximum": 90 },
              "lng": { "type": "number", "minimum": -180, "maximum": 180 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
