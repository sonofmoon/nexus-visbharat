{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:nvb:auditor-evidence:v1",
  "title":"NVB Auditor portable evidence pack",
  "type":"object",
  "required":["success","manifest","record"],
  "properties":{
    "success":{"const":true},
    "manifest":{
      "type":"object","required":["schema_version","sha256","created_at","external_signature"],
      "properties":{
        "schema_version":{"const":"nvb-auditor-v1"},
        "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "created_at":{"type":"string","format":"date-time"},
        "external_signature":{"type":"null"}
      },"additionalProperties":false
    },
    "record":{
      "oneOf":[
        {"type":"object","required":["kind","scope","head_id","total","records","redacted","record_sha256"],"properties":{"kind":{"const":"audit_events"},"records":{"type":"array","items":{"type":"object","required":["id","action","actor","resource_type"]}},"redacted":{"const":true},"total":{"type":"integer","minimum":0}}},
        {"type":"object","required":["project","detail","decisions","evidence","readiness","nodes","edges","redacted","metadata"],"properties":{"project":{"type":"object","required":["project_id"]},"redacted":{"const":true},"evidence":{"type":"array"},"nodes":{"type":"array"},"edges":{"type":"array"}}},
        {"type":"object","required":["job_id","status","result","evaluation_scope"],"properties":{"status":{"const":"completed"},"result":{"type":"object","required":["overall","dataset_version","model_version","label_status"]}}}
      ]
    }
  },"additionalProperties":false
}
