{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:nvb:analyst-decision:v1",
  "title":"NVB portable draft decision evidence",
  "type":"object",
  "required":["schema_version","project_id","geography","request_ids","status","score","cost","provenance"],
  "properties":{
    "schema_version":{"const":"nvb-decision-v1"},
    "project_id":{"type":"string","pattern":"^NVB-P-[A-F0-9]{16}$"},
    "geography":{"type":"object","required":["state_code","district_code","code_system","lgd_code"],"properties":{"state_code":{"type":"string"},"district_code":{"type":"string"},"code_system":{"const":"NVB-local-v1"},"lgd_code":{"type":["string","null"]}}},
    "request_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "status":{"enum":["draft","reviewed","approved","rejected"]},
    "score":{"type":"object","required":["value","version","components"],"properties":{"value":{"type":"number","minimum":0,"maximum":100},"version":{"const":"nvb-decision-v1"},"components":{"type":"object"}}},
    "cost":{"type":"object","required":["currency","unit","low","high","status"],"properties":{"currency":{"const":"INR"},"unit":{"const":"lakh"},"low":{"type":"number","minimum":0},"high":{"type":"number","minimum":0},"status":{"enum":["illustrative","human_reviewed"]}}},
    "provenance":{"type":"object","required":["data_mode","source","scope","as_of"],"properties":{"data_mode":{"enum":["synthetic","operational","mixed","empty"]},"source":{"type":"string"},"scope":{"type":"object"},"as_of":{"type":["string","null"]}}}
  }
}
