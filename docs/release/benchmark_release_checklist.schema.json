{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus-visbharat.local/schemas/benchmark_release_checklist.schema.json",
  "title": "External Benchmark Nexus Release Checklist",
  "type": "object",
  "required": ["checklist_name", "version", "generated_at", "items"],
  "properties": {
    "checklist_name": { "type": "string", "minLength": 3 },
    "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+$" },
    "generated_at": { "type": "string", "minLength": 10 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "priority", "phase_gates", "criterion", "status", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^RG-[0-9]{3}$" },
          "title": { "type": "string", "minLength": 5 },
          "priority": { "type": "string", "enum": ["Must", "Should", "Could"] },
          "phase_gates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["phase2_processing", "phase3_policy", "phase4_policy_workflow", "phase5_transparency"]
            }
          },
          "criterion": { "type": "string", "minLength": 5 },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "WAIVED"] },
          "evidence": { "type": "array", "items": { "type": "string", "minLength": 2 } },
          "owner": { "type": "string" },
          "waiver_reason": { "type": "string" },
          "waiver_approved_by": { "type": "string" },
          "remediation_plan": { "type": "string" },
          "machine_check": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["phase_runner_pass", "evidence_files_exist", "report_contains", "composite"] },
              "required_phase_gates": { "type": "array", "items": { "type": "string" } },
              "file_path": { "type": "string" },
              "patterns": { "type": "array", "items": { "type": "string" } },
              "checks": { "type": "array", "items": { "$ref": "#/$defs/machine_check" } }
            },
            "allOf": [
              {
                "if": { "properties": { "type": { "const": "phase_runner_pass" } }, "required": ["type"] },
                "then": { "required": ["required_phase_gates"] }
              },
              {
                "if": { "properties": { "type": { "const": "report_contains" } }, "required": ["type"] },
                "then": { "required": ["file_path", "patterns"] }
              },
              {
                "if": { "properties": { "type": { "const": "composite" } }, "required": ["type"] },
                "then": { "required": ["checks"] }
              }
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "machine_check": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["phase_runner_pass", "evidence_files_exist", "report_contains", "composite"] },
        "required_phase_gates": { "type": "array", "items": { "type": "string" } },
        "file_path": { "type": "string" },
        "patterns": { "type": "array", "items": { "type": "string" } },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/machine_check" } }
      },
      "additionalProperties": true
    }
  }
}