# Nexus Citizen Voice - Production Environment Template
# Sanitized template: replace all <...> placeholders before deployment.

# ==============================
# Core App Security
# ==============================
SECRET_KEY=<LONG_RANDOM_SECRET_KEY>
ASR_AUDIT_EXPORT_SIGNING_SECRET=<LONG_RANDOM_PROD_SECRET_32PLUS_CHARS>

# API tokens (set strong random values)
ADMIN_API_TOKEN=<ADMIN_API_TOKEN>
ANALYST_API_TOKEN=<ANALYST_API_TOKEN>
AUDITOR_API_TOKEN=<AUDITOR_API_TOKEN>

# Database (choose one)
DATABASE_URL=<POSTGRES_URL_OR_EMPTY>
DATABASE_PATH=visbharat.db

# ==============================
# Layer 2 - Language Intelligence (ASR + Code-mix)
# ==============================

# Select primary ASR provider: bhashini | ai4bharat | google | simulation
# Recommended production values: bhashini or ai4bharat
LANGUAGE_ASR_PROVIDER=bhashini

# Strict mode true = fail fast if all live ASR providers fail
LANGUAGE_ASR_STRICT_MODE=true

# --- Bhashini adapter ---
USE_REAL_BHASHINI_ASR=true
BHASHINI_ASR_ENDPOINT=https://<YOUR_BHASHINI_ASR_ENDPOINT>
BHASHINI_ASR_API_KEY=<YOUR_BHASHINI_API_KEY>
BHASHINI_ASR_TIMEOUT_SECONDS=25

# --- AI4Bharat adapter ---
USE_REAL_AI4BHARAT_ASR=true
AI4BHARAT_ASR_ENDPOINT=https://<YOUR_AI4BHARAT_ASR_ENDPOINT>
AI4BHARAT_ASR_API_KEY=<YOUR_AI4BHARAT_ASR_API_KEY>
AI4BHARAT_ASR_TIMEOUT_SECONDS=25

# --- ASR circuit breaker ---
LANGUAGE_ASR_CIRCUIT_BREAKER_ENABLED=true
LANGUAGE_ASR_CIRCUIT_FAIL_THRESHOLD=3
LANGUAGE_ASR_CIRCUIT_OPEN_SECONDS=60

# ==============================
# Layer 2 Optional Google Integrations
# ==============================
USE_REAL_GOOGLE_STT=false
USE_REAL_GOOGLE_AI=false
GOOGLE_AI_API_KEY=<OPTIONAL_GOOGLE_AI_API_KEY>

# ==============================
# Deployment/Runtime
# ==============================
DEPLOYMENT_PROFILE=national
DEMO_MODE=false

# Upload + media
VOICE_MAX_BYTES=10485760

# ==============================
# Webhook / Channel Security (if enabled)
# ==============================
WEBHOOK_SHARED_TOKEN=<WEBHOOK_SHARED_TOKEN>
WEBHOOK_REQUIRE_REPLAY_PROTECTION=true
WEBHOOK_REPLAY_WINDOW_SECONDS=300
WEBHOOK_NONCE_CACHE_MAX=10000
WEBHOOK_BIND_REPLAY_IN_SIGNATURE=false

# ==============================
# Production notes
# ==============================
# 1) Bhashini-first profile:
#    LANGUAGE_ASR_PROVIDER=bhashini
# 2) AI4Bharat-first profile:
#    LANGUAGE_ASR_PROVIDER=ai4bharat
# 3) Keep both USE_REAL_BHASHINI_ASR and USE_REAL_AI4BHARAT_ASR=true for fallback resilience.
# 4) Do not commit real secrets to source control.

DPDP_LAST_VERIFIED_AT=
DPDP_EVIDENCE_ARTIFACTS_JSON=[{"name":"Consent Ledger API","path":"/api/v1/governance/consent-ledger"}]
DPG_REGISTRATION_STATUS=in_progress
DPG_REGISTRY_ID=
DPG_PROJECT_URL=
DPG_OPEN_SOURCE_LICENSE=MIT
DPG_STATUS_LAST_UPDATED=
DPG_STATUS_NOTES=
DPG_EVIDENCE_LINKS_JSON=["/api/v1/governance/dpg-status"]
