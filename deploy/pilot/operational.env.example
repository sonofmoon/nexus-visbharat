DEMO_MODE=false
SEED_DEMO_DATA=false
AUTO_MIGRATE=false
LOCAL_EVALUATION_WORKER=false
PILOT_ONLY=true
PILOT_ID=vellore-tirupati-water
PILOT_MODEL_CALLS=false
PILOT_ANALYTICS_SYNC=false
USE_REAL_GOOGLE_AI=false
USE_VERTEX_FOR_GEMINI=true
VERTEX_PROJECT_ID=REPLACE
VERTEX_LOCATION=asia-south1
VERTEX_OPENAI_LOCATION=asia-south1
PILOT_MODEL_REGIONS_JSON=["asia-south1"]
# Set only after confirming the chosen Speech v2 model supports ta-IN/te-IN/en-IN in this region.
PILOT_SPEECH_LOCATION=
PILOT_SPEECH_MODEL=chirp_2
BIGQUERY_LOCATION=asia-south1
PILOT_BIGQUERY_TABLE=REPLACE.nvb_pilot.reports
PILOT_BQ_MAX_BYTES=1000000000
# Inject DATABASE_URL, SECRET_KEY and OIDC_CLIENT_SECRET from Secret Manager.
# DATABASE_URL format: postgresql://USER:URL_ENCODED_PASSWORD@/nvb_pilot?host=/cloudsql/PROJECT:asia-south1:nvb-pilot-mumbai
OIDC_ISSUER=https://identity.example.gov.in
OIDC_CLIENT_ID=REPLACE
OIDC_AUTHORIZATION_ENDPOINT=https://identity.example.gov.in/authorize
OIDC_TOKEN_ENDPOINT=https://identity.example.gov.in/token
OIDC_JWKS_URI=https://identity.example.gov.in/.well-known/jwks.json
OIDC_REDIRECT_URI=https://pilot.example.gov.in/pilot/callback
